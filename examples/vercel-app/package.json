{
  "name": "vercel-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @posthog/definitions build && node scripts/posthog-sync.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "posthog:apply": "pnpm --filter @posthog/definitions build && VERCEL_ENV=production node scripts/posthog-sync.mjs",
    "posthog:dry": "pnpm --filter @posthog/definitions build && node scripts/posthog-sync.mjs"
  },
  "dependencies": {
    "@posthog/definitions": "workspace:*",
    "next": "^14.2.15",
    "posthog-js": "^1.176.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
