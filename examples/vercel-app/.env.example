# === Server-side (build step) — used by posthog-definitions during `vercel build` ===
# Personal API key with dashboard:read/write and insight:read/write scopes.
# Create at <host>/settings/user-api-keys. Starts with `phx_`.
# This is NOT the project public token below. NEVER put this in a NEXT_PUBLIC_* var.
POSTHOG_PERSONAL_API_KEY=phx_replace_me

# Numeric project ID.
# WARNING: Use a DEDICATED DEV PROJECT. Do not set this to 2 (PostHog's real prod project).
POSTHOG_PROJECT_ID=000000

# Optional. Defaults to https://us.posthog.com.
# POSTHOG_HOST=https://eu.posthog.com

# === Client-side (browser) — exposed to posthog-js via Next.js NEXT_PUBLIC_* ===
# Public project API token. Starts with `phc_`. Found at Project settings → Project API key.
# Safe to ship to the browser. NOT the same as POSTHOG_PERSONAL_API_KEY above.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me

# Optional. Use the ingestion host (us.i.posthog.com / eu.i.posthog.com).
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
